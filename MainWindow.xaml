        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_Anim_RectangleAnimation_Ex"
        mc:Ignorable="d"
        Title="RectangeAnimation example" Height="357" Width="379">
